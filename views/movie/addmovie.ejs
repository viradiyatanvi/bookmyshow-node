

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Page</title>
    <style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background-color: #181818;
    color: #fff;
    padding-top: 80px;
}

/* Header */
.header {
    width: 100%;
    background: linear-gradient(to right, #E50914, #ff5722);
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 40px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    z-index: 1000;
}

.logo {
    font-size: 26px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 0 2px 10px rgba(255, 255, 255, 0.2);
}

nav ul {
    list-style: none;
    display: flex;
    gap: 20px;
}

nav ul li a {
    text-decoration: none;
    color: white;
    font-size: 16px;
    padding: 10px;
    border-radius: 5px;
    transition: 0.3s;
}

nav ul li a:hover {
    background-color: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
}

/* Form Styling */
h1 {
    text-align: center;
    margin-bottom: 20px;
    font-size: 26px;
    color: #ef5058;
}

form {
    width: 50%;
    margin: 20px auto;
    padding: 20px;
    background: #222;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(255, 255, 255, 0.2);
}

.form-group {
    margin-bottom: 15px;
}

label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
    color: #ef5058;
}

input[type="text"], 
input[type="number"], 
input[type="date"], 
textarea, 
input[type="file"] {
    width: 100%;
    padding: 10px;
    border: 2px solid #ef5058;
    border-radius: 5px;
    outline: none;
    background-color: #333;
    color: white;
}

textarea {
    height: 100px;
    resize: none;
}

/* Checkbox & Radio Buttons */
input[type="checkbox"], 
input[type="radio"] {
    margin-right: 8px;
    transform: scale(1.2);
}

/* Submit Button */
input[type="submit"] {
    background-color: #ef5058;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    display: block;
    margin: 20px auto 0;
    font-size: 16px;
    transition: 0.3s;
}

input[type="submit"]:hover {
    background-color: #ff5722;
}

/* Responsive Design */
@media (max-width: 768px) {
    form {
        width: 90%;
    }
}

    </style>
</head>
<body>
    <header class="header">
        <div class="logo">🎬 MovieZone</div>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/view_movie">Movies</a></li>
            </ul>
        </nav>
    </header>
    <h1>Movie Page</h1>
    <form action="/movie/insertdata" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label for="title">Enter Title:</label>
            <input type="text" name="title" id="title" placeholder="Enter movie title">
        </div>

        <div class="form-group">
            <label for="tagline">Enter Tagline:</label>
            <textarea name="tagline" id="tagline" placeholder="Enter movie tagline"></textarea>
        </div>

        <div class="form-group">
            <label>Enter Genre:</label>
            <input type="checkbox" name="gener" value="action">Action
            <input type="checkbox" name="gener" value="comedy">Comedy
            <input type="checkbox" name="gener" value="drama">Drama
        </div>

        <div class="form-group">
            <label>Enter Language:</label>
            <input type="checkbox" name="language" value="english">English
            <input type="checkbox" name="language" value="hindi">Hindi
            <input type="checkbox" name="language" value="gujarati">Gujarati
        </div>

        <div class="form-group">
            <label for="price">Enter Price:</label>
            <input type="number" name="price" id="price" placeholder="Enter movie price">
        </div>

        <div class="form-group">
            <label for="moviedate">Enter Date:</label>
            <input type="date" name="moviedate" id="moviedate">
        </div>

        <div class="form-group">
            <label for="image">Enter Image:</label>
            <input type="file" name="image" id="image">
        </div>

        <div class="form-group">
            <label>Enter Rating:</label>
            <input type="radio" name="rating" value="1">1
            <input type="radio" name="rating" value="2">2
            <input type="radio" name="rating" value="3">3
            <input type="radio" name="rating" value="4">4
            <input type="radio" name="rating" value="5">5
        </div>

        <input type="submit" name="submit" value="Submit">
    </form>
</body>
</html>
