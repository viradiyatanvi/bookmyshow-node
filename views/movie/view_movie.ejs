
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
   <style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

/* Header */
.header {
    width: 100%;
    background: linear-gradient(to right, #E50914, #ff5722);
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 40px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    z-index: 1000;
}

.logo {
    font-size: 26px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 0 2px 10px rgba(255, 255, 255, 0.2);
}

nav ul {
    list-style: none;
    display: flex;
    gap: 20px;
}

nav ul li a {
    text-decoration: none;
    color: white;
    font-size: 16px;
    padding: 10px;
    border-radius: 5px;
    transition: 0.3s;
}

nav ul li a:hover {
    background-color: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
}

/* Body */
body {
    margin: 0;
    padding: 0;
    background-color: #181818;
    color: #fff;
    padding-top: 80px;
}

/* Search Bar */
form {
    text-align: center;
    margin: 30px 0;
}

form input[type="text"] {
    padding: 10px;
    width: 250px;
    border: 2px solid #ef1d28;
    border-radius: 5px;
    outline: none;
    background-color: #222;
    color: white;
}

form input[type="submit"], button {
    padding: 10px 15px;
    background-color: #ef1d28;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: 0.3s;
}

/* Movie Container */
.movie-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    padding: 20px;
}

.movie-item {
    background: #222;
    border-radius: 8px;
    width: 230px;
    text-align: center;
    box-shadow: 0 4px 8px rgba(255, 255, 255, 0.1);
    transition: transform 0.3s;
}

.movie-item:hover {
    transform: scale(1.05);
}

.movie-item img {
    border-radius: 8px 8px 0 0;
    width: 100%;
    height: 160px;
    object-fit: cover;
}

.movie-item h3 {
    color: #ef1d28;
    font-size: 18px;
    margin-top: 10px;
}

.movie-item p {
    color: #ccc;
    font-size: 14px;
    margin: 5px 0;
}

.movie-item a button {
    margin: 10px;
    background-color: #ff9800;
    font-size: 14px;
    padding: 8px 12px;
}

.movie-item a button:hover {
    background-color: #ff5722;
}

/* Pagination */
.pagination {
    text-align: center;
    margin: 20px 0;
}

.pagination button {
    padding: 8px 12px;
    font-size: 16px;
    margin: 5px;
    border-radius: 5px;
}

.pagination button:disabled {
    background-color: #555;
}

/* Responsive Design */
@media (max-width: 768px) {
    .movie-container {
        flex-direction: column;
        align-items: center;
    }

    .movie-item {
        width: 90%;
    }
}

   </style>
</head>
<body>
    <header class="header">
        <div class="logo">🎬 MovieZone</div>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/view_movie">Movies</a></li>
            </ul>
        </nav>
    </header>
    <div id="carouselExampleAutoplaying" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
          <div class="carousel-item active">
            <img src="/images/1.avif" class="d-block w-100" style="height: 400px;" alt="...">
          </div>
          <div class="carousel-item">
            <img src="/images/2.avif" class="d-block w-100" style="height: 400px;" alt="...">
          </div>
          <div class="carousel-item">
            <img src="/images/3.avif" class="d-block w-100" style="height: 400px;" alt="...">
          </div>
          <div class="carousel-item">
            <img src="/images/4.avif" class="d-block w-100" style="height: 400px;" alt="...">
          </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    <form action="">
        <input type="text" name="search" value="<%= search %>" placeholder="movie search"/>
        <input type="submit" value="Search">
        <a href="/view_movie"><button type="button">Reset</button></a>
    </form>

    <div class="movie-container">
        <% singledata.map((v, i) => { %>
            <div class="movie-item">
                <img src="<%= v.image %>" alt="<%= v.title %>">
                <div>
                    <h3><%= v.title %></h3>
                    <p>Rating: <%= v.rating %></p>
                    <p>Genre: <%= v.gener %></p>
                    <a href="/movie/viewdata/<%= v.id %>"><button type="button">View</button></a>
                </div>
            </div>
        <% }) %>
    </div>

    <div class="pagination">
        <% if (parseInt(page) > 0) { %>
            <a href="/view_movie?page=<%= parseInt(page) - 1 %>&search=<%= search %>"><button>Previous</button></a>
        <% } else { %>
            <button disabled>Previous</button>
        <% } %>
        
        <a href="/view_movie?page=<%= page %>&search=<%= search %>"><button><%= parseInt(page) + 1 %></button></a>
        
        <% if (parseInt(page) < totalcount - 1) { %>
            <a href="/view_movie?page=<%= parseInt(page) + 1 %>&search=<%= search %>"><button>Next</button></a>
        <% } else { %>
            <button disabled>Next</button>
        <% } %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

</body>
</html>
